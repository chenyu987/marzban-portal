{
  // Cloudflare Workers 配置模板。复制成 wrangler.jsonc，按下面的注释改成自己的值
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marzban-portal",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // 每天 UTC 2 点（北京时间 10 点）发到期提醒邮件，见 custom-worker.ts
  "triggers": { "crons": ["0 2 * * *"] },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "marzban-portal" }],
  // 可选：让 Worker 在你的 Marzban 面板附近跑（填面板所在的云区域，比如东京是 aws:ap-northeast-1）。
  // 每个页面要查好几次数据库、调好几次 Marzban，Worker 离它们近，页面就快
  // "placement": { "region": "aws:ap-northeast-1" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "marzban-portal",
      // 用 `npx wrangler d1 create marzban-portal` 建库，把返回的 id 填在这里
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // 你的 Marzban 面板地址。本地开发在 .dev.vars 里覆盖成假 Marzban
    "MARZBAN_URL": "https://panel.example.com:8000"
  }
  // MARZBAN_USERNAME / MARZBAN_PASSWORD 是密钥：线上用 `npx wrangler secret put` 设置，本地写在 .dev.vars
}
